####
# This Dockerfile is used in order to build a container that runs the Spring Boot application in native (no JVM) mode
#
# Before building the docker image run:
#
# mvn package -Pnative -DskipTests
#
# Then, build the image with:
#
# docker build -f src/main/docker/Dockerfile.native -t spring/realworldapiservice .
#
# Then run the container using:
#
# docker run -i --rm -p 8080:8080 spring/realworldapiservice
#
###
# UBI 9 (glibc 2.34) is required: the GraalVM distribution used by the Spring Boot
# native profile links against GLIBC_2.32/2.34, which UBI 8 (glibc 2.28) does not provide.
FROM registry.access.redhat.com/ubi9/ubi-minimal
WORKDIR /work/
COPY target/realworld-api-spring /work/application
RUN chmod 775 /work
EXPOSE 8080
CMD ["./application"]
